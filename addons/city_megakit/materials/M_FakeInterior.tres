[gd_resource type="VisualShader" format=3 uid="uid://c5j2tqlobm57h"]

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_01bx1"]
size = Vector2(560, 180)
expression = "depth_scale = 1.0 / (1.0 - far_frac) - 1.0;"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_uqnod"]
size = Vector2(700, 520)
expression = "vec3 pos = vec3(uv * 2.0 - 1.0, -1.0);
vec3 rd = tvd;
rd.z *= -depth_scale;
vec3 id = 1.0 / rd;
vec3 k = abs(id) - pos * id;
float k_min = min(min(k.x, k.y), k.z);
pos += k_min * rd;
float interp = pos.z * 0.5 + 0.5;
float real_z = clamp(interp, 0.0, 1.0) / depth_scale + 1.0;
interp = 1.0 - (1.0 / real_z);
interp *= depth_scale + 1.0;
interior_uv = pos.xy * mix(1.0, far_frac, interp) * 0.5 + 0.5;"

[sub_resource type="VisualShaderNodeTexture2DParameter" id="VisualShaderNodeTexture2DParameter_xpajy"]
parameter_name = "curtain_texture"
texture_type = 1
color_default = 1

[sub_resource type="VisualShaderNodeTexture" id="VisualShaderNodeTexture_jcxq1"]
source = 5
texture_type = 1

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_8h3kp"]
input_name = "node_position_world"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_2txwl"]
size = Vector2(560, 280)
expression = "float r = pos.x * 127.1 + pos.y * 311.7 + pos.z * 999.0;
r = fract(sin(r) * 1100.0);
rand_raw = r;
rand_index = floor(r * 4.0);"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_kjx3f"]
size = Vector2(640, 300)
expression = "float i = (use_random > 0.5) ? idx : manual_idx;
float col = mod(i, 2.0);
float row = floor(i / 2.0);
curtain_uv = (base_uv * 0.5) + vec2(col * 0.5, row * 0.5);"

[sub_resource type="VisualShaderNodeMix" id="VisualShaderNodeMix_xho32"]
